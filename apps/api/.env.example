NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agrimarket
DB_PASSWORD=replace-with-a-local-password
# Use a COPY of the original database. No schema changes run on API startup.
DB_NAME=agrimarket_ts
COOKIE_SECURE=false
# Set to loopback only behind a local reverse proxy that overwrites forwarded headers.
TRUST_PROXY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_ENCRYPTION_KEY=replace-with-64-hex-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AgriMarket <noreply@agrimarket.local>
# Private directory, outside any web root
UPLOAD_DIR=../../storage/node-uploads
# Optional, safe default: payments are COD until this is explicitly enabled.
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
